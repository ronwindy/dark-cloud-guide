---
import BaseLayout from '../../layouts/BaseLayout.astro';
import project from '../../../project.config.json';
import { getPages, readPageFile, renderText, getNeighbours } from '../../lib/guideData';
import { Check, ChevronLeft, ChevronRight, Moon, Sparkle } from '@lucide/astro';

export function getStaticPaths() {
  return getPages().map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { prev, next } = getNeighbours(page.id);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const html = renderText(readPageFile(page.file));
const href = (id: string) => `${baseUrl}/guide/${id}`;
---

<BaseLayout
  title={`${page.title} — ${project.pageTitleSuffix}`}
  description={`${project.pageDescriptionPrefix} — ${page.group}: ${page.title}`}
  currentId={page.id}
>
  <article class="max-w-5xl mx-auto space-y-6">
    <div class="crumb-bar">
      <div class="crumb-line" aria-hidden="true"></div>
      <nav aria-label="Breadcrumb" class="crumb-nav">
        <a href={`${baseUrl}/`} class="crumb-chip">
          <Moon class="crumb-icon w-3 h-3" fill="currentColor" aria-hidden="true" />Contents
        </a>
        <Sparkle class="crumb-spark w-2.5 h-2.5" fill="currentColor" aria-hidden="true" />
        <span class="truncate min-w-0">{page.group}</span>
      </nav>
      <div class="crumb-line crumb-line-low" aria-hidden="true"></div>
    </div>

    <header class="text-center">
      <h1 class="page-title" data-title={page.title}>{page.title}</h1>
      <div class="page-title-rule mx-auto" aria-hidden="true"><span></span></div>
    </header>

    <div class="guide-body">
      <pre class="guide-text font-source-art custom-scrollbar" set:html={html} />
    </div>

    <nav class="pager" aria-label="Previous and next page">
      {prev ? (
        <a href={href(prev.id)} class="pager-btn pager-prev" rel="prev">
          <span class="pager-sheen" aria-hidden="true"></span>
          <span class="pager-stud" aria-hidden="true"></span>
          <ChevronLeft class="pager-icon" aria-hidden="true" />
          <span class="pager-text"><span class="pager-label">Previous</span><span class="pager-title">{prev.title}</span></span>
        </a>
      ) : <span class="pager-slot" aria-hidden="true"></span>}
      <button type="button" class="mark-read" data-mark-read={page.id} aria-pressed="false" aria-label="Mark as read" title="Mark as read">
        <Check class="mark-read__icon" aria-hidden="true" />
      </button>
      {next ? (
        <a href={href(next.id)} class="pager-btn pager-next" rel="next">
          <span class="pager-sheen" aria-hidden="true"></span>
          <span class="pager-stud" aria-hidden="true"></span>
          <span class="pager-text"><span class="pager-label">Next</span><span class="pager-title">{next.title}</span></span>
          <ChevronRight class="pager-icon" aria-hidden="true" />
        </a>
      ) : <span class="pager-slot" aria-hidden="true"></span>}
    </nav>
  </article>
</BaseLayout>
