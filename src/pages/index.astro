---
import BaseLayout from '../layouts/BaseLayout.astro';
import project from '../../project.config.json';
import { getToc } from '../lib/guideData';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const groups = getToc();
---

<BaseLayout>
  <div class="max-w-4xl mx-auto space-y-8">
    <header class="text-center space-y-4">
      <img src={`${baseUrl}/logo.png`} alt={project.game} class="mx-auto h-24 w-auto object-contain" />
      <h1 class="page-title ink-heading text-3xl sm:text-4xl font-serif font-semibold">{project.defaultTitle}</h1>
      <div class="page-title-rule mx-auto" aria-hidden="true"><span></span></div>
      <p class="text-sm text-slate-400">By AdrenalineSL &amp; Azaroth, version 2.0 (8/14/02)</p>
      <a class="progress-resume" data-progress-resume href={`${baseUrl}/`} hidden>Continue reading</a>
    </header>

    {groups.map((g) => (
      <section>
        <h2 class="text-lg font-serif font-medium uppercase tracking-wider text-moon-400 border-b border-slate-800/80 pb-2 mb-3">{g.group}</h2>
        <ul class="space-y-1">
          {g.entries.map((entry) => (
            <li>
              <a class="hover:text-moon-300 text-slate-300" href={`${baseUrl}/guide/${entry.id}`} data-page-id={entry.id}>{entry.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
