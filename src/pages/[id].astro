---
import GuidePage from '../layouts/GuidePage.astro';
import { pages, articleHtml } from '../lib/guideData';

export function getStaticPaths() {
  return pages.map((p) => ({ params: { id: p.id } }));
}
const { id } = Astro.params;
---
<GuidePage id={id!}><Fragment set:html={articleHtml(id!)} /></GuidePage>
