<WeaponCard title="Inferno" rows={[
  ["AT 350"],
  ["MG 300"],
]} />
<WeaponCard title="Tall Hammer" rows={[
  ["AT 260"],
  ["MG 200"],
]} />
</WeaponGrid>
<OrigBox is:raw>         ===================================================
         |   Inferno                                       |
         ===================================================
         |   AT   350                                      |
         |   MG   300                                      |
         ===================================================
         |   Tall Hammer                                   |
         ===================================================
         |   AT   260                                      |
         |   MG   200                                      |
         ===================================================</OrigBox>
