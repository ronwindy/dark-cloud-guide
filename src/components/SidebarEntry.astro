---
interface Props {
  href: string;
  title: string;
  icon: any;
  isActive: boolean;
  pageId?: string;
}

const { href, title, icon: EntryIcon, isActive, pageId } = Astro.props;
---

<a
  href={href}
  data-page-id={pageId}
  class={`sidebar-link block px-2.5 py-1.5 rounded transition-colors ${isActive ? 'sidebar-link--active' : ''}`}
  title={title}
>
  <span class="flex items-center gap-2 min-w-0">
    <EntryIcon class="w-3.5 h-3.5 flex-shrink-0 text-moon-500" aria-hidden="true" />
    <span class="truncate min-w-0">{title}</span>
  </span>
</a>
