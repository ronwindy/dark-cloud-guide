---
// Sticky top bar: menu button (narrow screens), brand link home, day / night theme toggle.
---
<header class="topbar">
  <button class="iconbtn" id="menuBtn" aria-label="Menu" title="Menu (m)"><svg class="ic"><use href="#i-menu"></use></svg></button>
  <a class="brand" href="index.html"><svg class="ic"><use href="#i-cloud"></use></svg><span>Dark Cloud Chronicle</span></a>
  <div class="tools"><button class="iconbtn" id="themeBtn" title="Day / night parchment (t)"><svg class="ic"><use href="#i-moonsun"></use></svg></button></div>
</header>

<script>
  // The saved theme is applied before paint by an inline script in BaseLayout.
  import { KEYS, setItem } from '../lib/client/storage.js';
  import { toggleMenu } from '../lib/client/menu.js';

  document.getElementById('themeBtn')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    setItem(KEYS.theme, next);
  });
  document.getElementById('menuBtn')?.addEventListener('click', () => toggleMenu());
</script>

<style>
/* topbar */
.topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.45rem 0.8rem;
  background: linear-gradient(var(--paper2), var(--paper));
  border-bottom: 2px solid var(--line);
  box-shadow: 0 2px 10px var(--shadow);
}
.brand {
  font-family: var(--f-disp);
  font-size: 1.02rem;
  color: var(--ink);
  text-decoration: none;
  display: flex;
  gap: 0.5rem;
  align-items: center;
  letter-spacing: 0.02em;
}
.brand .ic {
  color: var(--accent);
}
.tools {
  margin-left: auto;
  display: flex;
  gap: 0.3rem;
}
.iconbtn {
  background: none;
  border: 1px solid var(--line);
  color: var(--ink);
  border-radius: 8px;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  cursor: pointer;
  font-size: 1.05rem;
}
.iconbtn:hover {
  background: var(--paper3);
}
@media (min-width: 1180px) {
  #menuBtn {
    display: none;
  }
  .topbar {
    padding-left: 1.2rem;
  }
}
@media print {
  .topbar {
    display: none;
  }
}
</style>
