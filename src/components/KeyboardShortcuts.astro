---
// Keyboard shortcuts: ←/→ page, x read, t theme, m menu, / filter, h home, Esc close.
---
<script>
  import { pages, currentId } from '../lib/client/guide.js';
  import { toggleMenu } from '../lib/client/menu.js';

  function goToNeighbour(offset: number) {
    const i = pages.findIndex((p) => p.id === currentId);
    const target = pages[i + offset];
    if (i > -1 && target) location.href = target.file;
  }

  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    const tag = el.tagName;

    if (e.key === 'Escape') {
      if (tag === 'INPUT') el.blur();
      else toggleMenu(false);
      return;
    }
    if (tag === 'INPUT' || tag === 'TEXTAREA' || e.ctrlKey || e.metaKey || e.altKey) return;

    const filterInput = document.getElementById('filter');
    switch (e.key.toLowerCase()) {
      case 'arrowright': goToNeighbour(1); break;
      case 'arrowleft': goToNeighbour(-1); break;
      case 'x': document.getElementById('sealBtn')?.click(); break;
      case 't': document.getElementById('themeBtn')?.click(); break;
      case 'm': toggleMenu(); break;
      case 'h': location.href = 'index.html'; break;
      case '/':
        if (filterInput) {
          e.preventDefault();
          filterInput.focus();
        }
        break;
    }
  });
</script>
