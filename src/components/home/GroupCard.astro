---
// One sidebar group on the home page: its icon, title and page list.
import { pages, type GroupEntry } from '../../lib/guideData';
interface Props { group: GroupEntry }
const { group } = Astro.props;
const groupPages = pages.filter((p) => p.group === group.id);
---
<section class="gcard"><h2><svg class="ic"><use href={`#i-${group.icon}`}/></svg>{group.title}</h2><div class="plist">{groupPages.map((p) => <a class="pcard" data-id={p.id} href={p.file}><span class="tick"></span><span>{p.title}</span></a>)}</div></section>

<script>
  // Read ticks and a "last visited" marker on the page links.
  import { KEYS, getItem } from '../../lib/client/storage.js';
  import { isRead } from '../../lib/client/readState.js';

  const lastId = getItem(KEYS.last);
  document.querySelectorAll<HTMLElement>('.pcard').forEach((card) => {
    if (isRead(card.dataset.id!)) card.classList.add('read');
    if (card.dataset.id === lastId) card.classList.add('last');
  });
</script>

<style>
.gcard {
  background: var(--paper3);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 0.8rem 1rem 1rem;
  box-shadow: 0 3px 10px var(--shadow);
}
:global(:root[data-theme="dark"]) .gcard {
  background: var(--paper2);
}
.gcard h2 {
  margin: 0 0 0.5rem;
  font-family: var(--f-head);
  font-size: 1rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--accent);
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.plist {
  display: flex;
  flex-direction: column;
}
.pcard {
  display: flex;
  gap: 0.55rem;
  align-items: center;
  padding: 0.28rem 0.3rem;
  text-decoration: none;
  color: var(--ink);
  border-radius: 6px;
  font-size: 0.98rem;
  line-height: 1.25;
}
.pcard:hover {
  background: var(--paper2);
}
.pcard .tick {
  width: 0.65rem;
  height: 0.65rem;
  border-radius: 50%;
  border: 1.5px solid var(--muted);
  flex: none;
}
.pcard.read .tick {
  background: var(--accent);
  border-color: var(--accent);
}
.pcard.last {
  box-shadow: inset 3px 0 0 var(--gold);
}
</style>
