---
// "N of M pages read" bar. Filled in on the client from the saved read state.
import { pages } from '../../lib/guideData';
---
<div class="progress"><div class="bar"><i id="barFill"></i></div><small id="barTxt">0 of {pages.length} pages read</small></div>

<script>
  import { pages } from '../../lib/client/guide.js';
  import { isRead } from '../../lib/client/readState.js';

  const readCount = pages.filter((p) => isRead(p.id)).length;
  const fill = document.getElementById('barFill');
  const label = document.getElementById('barTxt');
  if (fill) fill.style.width = `${(100 * readCount) / pages.length}%`;
  if (label) label.textContent = `${readCount} of ${pages.length} pages read`;
</script>

<style>
.progress {
  min-width: 220px;
  text-align: left;
}
.progress .bar {
  height: 10px;
  border-radius: 99px;
  background: var(--paper2);
  border: 1px solid var(--line);
  overflow: hidden;
}
.progress .bar i {
  display: block;
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, var(--gold), var(--accent));
  transition: width 0.4s;
}
.progress small {
  color: var(--muted);
}
</style>
