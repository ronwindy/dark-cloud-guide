---
import Scene from '../Scene.astro';
import ReadProgress from './ReadProgress.astro';
import { pages } from '../../lib/guideData';
---
<section class="hero">
<Scene name="home" wide />
<p class="kicker">An unofficial strategy guide, rebound</p>
<h1>Dark Cloud <span>Chronicle</span></h1>
<p class="lede">Rebuild the world, one Atla at a time. The complete walkthrough, Georama maps, weapon trees, bestiary and boss strategies, set in a book you can alt-tab to.</p>
<div class="cta"><a class="btn primary" id="resume" href={pages[0].file}>Begin the journey</a><ReadProgress /></div>
</section>

<script>
  // "Begin the journey" becomes "Resume: <last page>" once a page has been visited.
  import { findPage } from '../../lib/client/guide.js';
  import { KEYS, getItem } from '../../lib/client/storage.js';

  const lastId = getItem(KEYS.last);
  const lastPage = lastId && findPage(lastId);
  const resume = document.getElementById('resume') as HTMLAnchorElement | null;
  if (resume && lastPage) {
    resume.href = lastPage.file;
    resume.textContent = `Resume: ${lastPage.title}`;
  }
</script>

<style>
/* home */
.hero {
  text-align: center;
  padding: 1rem 0 0.5rem;
}
.hero :global(.scene) {
  border: 2px solid var(--line);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 24px var(--shadow);
  margin-bottom: 1.2rem;
}
.kicker {
  font-family: var(--f-head);
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-size: 0.78rem;
  color: var(--muted);
  margin: 0.2rem 0;
}
.hero h1 {
  font-family: var(--f-disp);
  font-size: clamp(2rem, 6vw, 3.6rem);
  margin: 0.1rem 0;
  line-height: 1.05;
  color: var(--ink);
}
.hero h1 span {
  color: var(--accent);
}
.lede {
  max-width: 40rem;
  margin: 0.6rem auto 1.2rem;
  color: var(--ink2);
  font-size: 1.12rem;
}
.cta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  align-items: center;
  justify-content: center;
}
.btn {
  font-family: var(--f-head);
  text-decoration: none;
  padding: 0.7rem 1.4rem;
  border-radius: 99px;
  border: 2px solid var(--gold);
  color: var(--ink);
  background: var(--paper3);
  letter-spacing: 0.06em;
}
.btn.primary {
  background: linear-gradient(var(--accent), #6d2218);
  color: #fff6e0;
  border-color: var(--gold);
  box-shadow: 0 4px 12px var(--shadow);
}
</style>
