---
// Boxed aside: a reader-submitted tip or a chapter's boss fight.
interface Props { kind: 'tip' | 'boss'; label?: string }
const { kind, label = kind === 'tip' ? 'Reader tip' : 'Boss fight' } = Astro.props;
const icon = kind === 'tip' ? 'scroll' : 'skull';
---
<aside class={`callout ${kind}`}><div class="ct"><svg class="ic"><use href={`#i-${icon}`}/></svg>{label}</div><slot /></aside>

<style is:global>
/* callouts */
.callout {
  margin: 1.3rem 0;
  border-radius: 10px;
  padding: 0.2rem 1rem 0.5rem;
  position: relative;
  border: 1px solid var(--line);
}
.callout .ct {
  font-family: var(--f-head);
  font-size: 0.82rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.55rem 0 0.1rem;
  font-weight: 700;
}
.callout.tip {
  background: rgba(184, 134, 43, 0.12);
  border-left: 6px solid var(--gold);
}
.callout.tip .ct {
  color: var(--gold);
}
.callout.boss {
  background: rgba(140, 47, 35, 0.1);
  border-left: 6px solid var(--accent);
}
.callout.boss .ct {
  color: var(--accent);
}
.callout .by {
  font-style: italic;
  color: var(--muted);
  margin: 0.1em 0;
}
</style>
