---
// Framed ASCII map or diagram with zoom buttons. Use with is:raw so the art is kept verbatim:
// <MapFrame label="Diagram" small is:raw>...</MapFrame>
interface Props { label?: string; small?: boolean }
const { label = 'ASCII map', small = false } = Astro.props;
---
<figure class:list={['mapframe', { small }]}><div class="mapbar"><span>{label}</span></div><div class="mapscroll"><pre class="ascii"><slot /></pre></div></figure>

<script>
  // A− / A+ zoom buttons on every map frame.
  const START_SIZE_PX = 12.5;
  const MIN_SIZE_PX = 7;
  const MAX_SIZE_PX = 24;
  const STEP_PX = 1.5;

  document.querySelectorAll('.mapframe .mapbar').forEach((bar) => {
    const pre = bar.parentNode!.querySelector('pre')!;
    let size = START_SIZE_PX;
    const zoomBy = (delta: number) => {
      size = Math.max(MIN_SIZE_PX, Math.min(MAX_SIZE_PX, size + delta));
      pre.style.fontSize = `${size}px`;
    };
    for (const [label, direction] of [['A−', -1], ['A+', 1]] as const) {
      const button = document.createElement('button');
      button.textContent = label;
      button.title = 'Zoom';
      button.addEventListener('click', () => zoomBy(direction * STEP_PX));
      bar.appendChild(button);
    }
  });
</script>

<style is:global>
/* ASCII + maps */
.mapframe {
  margin: 1.3rem 0;
  border: 3px double var(--gold);
  border-radius: 6px;
  background: var(--code-bg);
  box-shadow:
    inset 0 0 40px rgba(120, 80, 20, 0.15),
    0 3px 10px var(--shadow);
  position: relative;
}
.mapframe::before,
.mapframe::after {
  content: "✦";
  position: absolute;
  color: var(--gold);
  font-size: 1rem;
  top: -0.7rem;
  background: var(--paper3);
  padding: 0 0.25rem;
  line-height: 1;
}
.mapframe::before {
  left: 1rem;
}
.mapframe::after {
  right: 1rem;
}
:root[data-theme="dark"] .mapframe::before,
:root[data-theme="dark"] .mapframe::after {
  background: var(--paper2);
}
.mapbar {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.6rem;
  border-bottom: 1px solid var(--line);
  font-family: var(--f-head);
  font-size: 0.74rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}
.mapbar span {
  margin-right: auto;
}
.mapbar button {
  font: inherit;
  font-size: 0.8rem;
  letter-spacing: 0;
  background: var(--paper3);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 0.05rem 0.5rem;
  cursor: pointer;
}
.mapscroll {
  overflow: auto;
  padding: 0.7rem 0.8rem;
  max-height: 78vh;
}
.mapframe.small .mapscroll {
  max-height: none;
}
</style>
