---
// Centred chapter title inside a walkthrough page.
interface Props { id: string }
---
<h2 class="chapter" id={Astro.props.id}><slot /></h2>

<style is:global>
.prose h2.chapter {
  font-family: var(--f-disp);
  font-size: 1.7rem;
  text-align: center;
  border: 0;
  margin-top: 2.4rem;
  padding: 0.8rem 0;
  background: linear-gradient(90deg, transparent, var(--paper2), transparent);
}
.prose h2.chapter::before {
  content: none;
}
</style>
