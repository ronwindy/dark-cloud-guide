---
// One weapon's stats as chips.
// rows: one entry per table row. A row is a list of cells; a cell is one chip ("AT 350"),
// several chips (["Dr 99", "Be 99"]) or a note ({ note: "..." }). A one-cell row spans the card.
type Cell = string | string[] | { note: string };
interface Props {
  title: string;
  /** Small italic remark after the name, e.g. "Stats Pending". */
  remark?: string;
  /** Stats are estimates (adds a ≈ after the name). */
  approx?: boolean;
  /** Filter key; defaults to the lowercase title. */
  name?: string;
  rows?: Cell[][];
}
const { title, remark, approx = false, name = title.toLowerCase(), rows } = Astro.props;
const chips = (cell: string | string[]) => (Array.isArray(cell) ? cell : [cell]);
---
<div class:list={['wcard', { approx }]} data-name={name}><h5>{title}{remark && <> <em>{remark}</em></>}</h5>{rows && (
  <table class="wstat">{rows.map((row) => (
    <tr>{row.map((cell) =>
      typeof cell === 'object' && !Array.isArray(cell)
        ? <td colspan="3" class="wnote">{cell.note}</td>
        : <td colspan={row.length === 1 ? '3' : undefined}>{chips(cell).map((c, i) => <>{i > 0 && ' '}<span class="chip">{c}</span></>)}</td>
    )}</tr>
  ))}</table>
)}</div>

<style>
.wcard {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 0.55rem 0.7rem;
  background: var(--paper);
  box-shadow: 0 2px 6px var(--shadow);
}
.wcard h5 {
  font-size: 1rem;
  color: var(--accent);
  margin-bottom: 0.3rem;
  border-bottom: 1px solid var(--line);
  padding-bottom: 0.25rem;
}
.wcard h5 em {
  font-size: 0.75rem;
  color: var(--muted);
  font-family: var(--f-body);
}
.wcard.approx h5::after {
  content: " ≈";
  color: var(--muted);
  font-weight: 400;
}
.wstat {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.85rem;
}
.wstat td {
  padding: 0.12rem 0.15rem;
  vertical-align: top;
}
.wstat td.wnote {
  font-style: italic;
  color: var(--ink2);
  padding: 0.25rem 0;
}
.chip {
  display: inline-block;
  font-family: var(--f-mono);
  font-size: 0.78rem;
  background: var(--paper3);
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 0 0.35rem;
  margin: 1px 2px 1px 0;
  white-space: nowrap;
}
</style>
