---
// One bestiary / boss entry: a heading and its paragraphs. `name` (lowercase) is what the filter matches.
interface Props { id: string; title: string; name?: string }
const { id, title, name = title.toLowerCase() } = Astro.props;
---
<section class="entry" data-name={name}><h3 id={id}>{title}</h3><slot /></section>
