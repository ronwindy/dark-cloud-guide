---
// Previous / next links (from manifest order) around the "Mark as read" seal.
import { neighbours } from '../lib/guideData';
interface Props { id: string }
const { prev, next } = neighbours(Astro.props.id);
---
<nav class="pager">{prev ? <a class="prev" href={prev.file}><small>Previous</small>{prev.title}</a> : <span></span>}<button class="seal-btn" id="sealBtn" title="Mark as read (x)"><svg class="ic"><use href="#i-seal"/></svg><span>Mark as read</span></button>{next ? <a class="next" href={next.file}><small>Next</small>{next.title}</a> : <span></span>}</nav>

<script>
  // "Mark as read" seal. The sidebar repaints its ticks on the read-change event.
  import { currentId } from '../lib/client/guide.js';
  import { isRead, toggleRead } from '../lib/client/readState.js';

  const seal = document.getElementById('sealBtn');
  if (seal) {
    const paint = () => {
      const read = isRead(currentId);
      seal.classList.toggle('on', read);
      seal.querySelector('span')!.textContent = read ? 'Read ✓' : 'Mark as read';
    };
    seal.addEventListener('click', () => {
      toggleRead(currentId);
      paint();
    });
    paint();
  }
</script>

<style>
/* pager */
.pager {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0.8rem;
  align-items: stretch;
  margin: 1.6rem 0 0.6rem;
}
.pager a {
  display: block;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 0.6rem 0.9rem;
  text-decoration: none;
  color: var(--ink);
  background: var(--paper3);
  font-family: var(--f-head);
  font-size: 0.92rem;
  line-height: 1.3;
  box-shadow: 0 2px 6px var(--shadow);
}
.pager a:hover {
  border-color: var(--accent);
}
.pager small {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
}
.pager .next {
  text-align: right;
}
.seal-btn {
  border: 0;
  background: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.15rem;
  cursor: pointer;
  color: var(--muted);
  font-family: var(--f-head);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 0 0.4rem;
}
.seal-btn .ic {
  width: 2.6rem;
  height: 2.6rem;
  fill: none;
  stroke: var(--muted);
  transition: 0.2s;
}
.seal-btn.on {
  color: var(--accent);
}
.seal-btn.on .ic {
  fill: var(--accent);
  stroke: var(--accent);
  filter: drop-shadow(0 2px 3px var(--shadow));
}
@media (max-width: 640px) {
  .pager {
    grid-template-columns: 1fr 1fr;
  }
  .seal-btn {
    grid-column: 1/-1;
    order: -1;
    flex-direction: row;
    justify-content: center;
  }
}
@media print {
  .pager {
    display: none;
  }
}
</style>
