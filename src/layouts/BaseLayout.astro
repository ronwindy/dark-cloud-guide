---
import Navigation from '../components/Navigation.astro';
import MobileNavDrawer from '../components/MobileNavDrawer.astro';
import SidebarNav from '../components/SidebarNav.astro';
import '../styles/global.css';
import project from '../../project.config.json';

interface Props {
  title?: string;
  description?: string;
  currentId?: string;
  isWide?: boolean;
  showSidebar?: boolean;
}

const {
  title = project.defaultTitle,
  description = project.defaultDescription,
  currentId = "",
  isWide = true,
  showSidebar = true
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0a1f" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}/favicon-512.png`} />
    <link rel="apple-touch-icon" href={`${baseUrl}/apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Jost:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Apply saved sidebar state before first paint (no flash). Default: collapsed below 1280px.
      (function () {
        var state = null;
        try { state = localStorage.getItem('dark-cloud-sidebar-state'); } catch (e) {}
        if (state !== 'open' && state !== 'collapsed') {
          state = window.innerWidth < 1280 ? 'collapsed' : 'open';
        }
        document.documentElement.setAttribute('data-sidebar', state);
      })();
    </script>
    <style is:global>
      .sidebar-aside {
        transition: width 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-aside {
        width: 0;
        border-right-width: 0;
      }
      .sidebar-toggle {
        position: absolute;
        top: 50%;
        left: 100%;
        transform: translateY(-50%);
        width: 20px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #bdb6dc;
        background: #0b0919;
        border: 1px solid rgba(196, 158, 69, 0.35);
        border-left: 0;
        border-radius: 0 8px 8px 0;
        cursor: pointer;
        transition: color 0.15s ease, background-color 0.15s ease;
      }
      .sidebar-toggle:hover,
      .sidebar-toggle:focus-visible {
        color: #f6e7b4;
        background: #1a1736;
      }
      .sidebar-toggle svg {
        transition: transform 0.25s ease;
      }
      html[data-sidebar='collapsed'] .sidebar-toggle svg {
        transform: rotate(180deg);
      }
      @media (prefers-reduced-motion: reduce) {
        .sidebar-aside,
        .sidebar-toggle svg {
          transition: none;
        }
      }
    </style>
  </head>
  <body class="bg-void text-slate-100 flex flex-col min-h-dvh relative selection:bg-violet-500/40 selection:text-lavender-200">
    <!-- Site background: night-village art under a dark violet overlay. Fixed on desktop; on small/touch
         screens it is a static header-height backdrop using the smaller JPG (see global.css). -->
    <div
      class="site-bg pointer-events-none -z-10 overflow-hidden"
      style={`--bg-desktop: url(${baseUrl}/background.jpg); --bg-mobile: url(${baseUrl}/background-mobile.jpg);`}
      aria-hidden="true"
    >
      <div class="site-bg__img absolute inset-0"></div>
      <div class="site-bg__veil absolute inset-0"></div>
    </div>

    <Navigation />
    <MobileNavDrawer currentId={currentId} />

    <div class="flex-grow flex min-h-dvh w-full relative">
      {showSidebar && (
        <div class="sidebar-shell hidden lg:block flex-shrink-0 sticky top-0 h-screen z-30">
          <aside id="desktop-sidebar" class="sidebar-aside h-full lg:w-72 xl:w-80 ink-sidebar relative border-r border-slate-800/80 overflow-hidden">
            <div class="flex flex-col h-full w-72 xl:w-80">
              <SidebarNav currentId={currentId} />
            </div>
          </aside>
          <button
            type="button"
            id="sidebar-toggle"
            class="sidebar-toggle"
            aria-controls="desktop-sidebar"
            aria-expanded="true"
            aria-label="Hide chapter sidebar"
            title="Hide/show sidebar"
          >
            <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12.5 4.5 7 10l5.5 5.5" />
            </svg>
          </button>
        </div>
      )}
      <div class="flex-1 min-w-0 flex flex-col justify-between">
        <main class={`page-main flex-grow w-full mx-auto py-4 sm:py-6 lg:py-8 ${isWide ? 'max-w-[1440px]' : 'max-w-5xl'}`}>
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      // Mobile: hide the header while scrolling down, show it again on scroll up (a floating menu button covers the gap).
      (function () {
        var root = document.documentElement, last = window.scrollY, ticking = false;
        function update() {
          var y = Math.max(0, window.scrollY), d = y - last;
          if (y < 80 || d < -8) { root.removeAttribute('data-header-hidden'); last = y; }
          else if (d > 8) { root.setAttribute('data-header-hidden', ''); last = y; }
          ticking = false;
        }
        addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      })();
    </script>

    <script is:inline>
      (function () {
        var btn = document.getElementById('sidebar-toggle');
        var aside = document.getElementById('desktop-sidebar');
        if (!btn || !aside) return;
        var root = document.documentElement;
        function sync() {
          var collapsed = root.getAttribute('data-sidebar') === 'collapsed';
          btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          btn.setAttribute('aria-label', collapsed ? 'Show chapter sidebar' : 'Hide chapter sidebar');
          if (collapsed) aside.setAttribute('inert', ''); else aside.removeAttribute('inert');
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-sidebar') === 'collapsed' ? 'open' : 'collapsed';
          root.setAttribute('data-sidebar', next);
          try { localStorage.setItem('dark-cloud-sidebar-state', next); } catch (e) {}
          sync();
        });
        sync();
      })();
    </script>

    <script is:inline>
      // Reading progress: per-page "read" marks and the last page opened, kept in this browser only.
      (function () {
        var KEY = 'dark-cloud-progress-v1';
        var state = { done: {}, last: '' };
        try { var raw = JSON.parse(localStorage.getItem(KEY) || '{}'); if (raw && raw.done) state = { done: raw.done, last: raw.last || '' }; } catch (e) {}
        function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }
        var current = document.querySelector('#desktop-sidebar [data-active="true"] a[data-page-id]');
        if (current) { state.last = current.getAttribute('data-page-id'); save(); }

        function paint() {
          document.querySelectorAll('a[data-page-id]').forEach(function (a) { a.toggleAttribute('data-done', !!state.done[a.getAttribute('data-page-id')]); });
          document.querySelectorAll('[data-progress-resume]').forEach(function (a) {
            var target = document.querySelector('a[data-page-id="' + state.last + '"]');
            if (state.last && target) { a.href = target.href; a.hidden = false; a.textContent = 'Continue reading: ' + target.textContent.trim(); } else { a.hidden = true; }
          });
          document.querySelectorAll('[data-mark-read]').forEach(function (b) {
            var on = !!state.done[b.getAttribute('data-mark-read')];
            b.setAttribute('aria-pressed', String(on));
            b.textContent = on ? 'Read ✓ (click to undo)' : 'Mark as read';
          });
        }
        document.querySelectorAll('[data-mark-read]').forEach(function (b) {
          b.addEventListener('click', function () {
            var id = b.getAttribute('data-mark-read');
            if (state.done[id]) delete state.done[id]; else state.done[id] = 1;
            save(); paint();
          });
        });
        paint();
      })();
    </script>
  </body>
</html>

