---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import Topbar from '../components/Topbar.astro';
import Sidebar from '../components/Sidebar.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
interface Props { id: string; title: string; mainClass?: string }
const { id, title, mainClass = 'page' } = Astro.props;
const themeJs = "try{var t=localStorage.getItem('dc_theme');if(t)document.documentElement.dataset.theme=t}catch(e){}";
---
<!doctype html>
<html lang="en" data-page={id}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Cinzel:wght@500;700&family=IM+Fell+English:ital@0;1&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet" />
  <script is:inline set:html={themeJs}></script>
</head>
<body class="">
  <IconSprite />
  <Topbar />
  <Sidebar currentId={id} />
  <main class={mainClass} id="main"><slot /></main>
  <KeyboardShortcuts />
</body>
</html>
